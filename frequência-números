#include <stdio.h>
#include <stdlib.h>

int comparar(const void *a, const void *b) {
    int va = *(const int *)a;
    int vb = *(const int *)b;
    return va - vb;
}

int main(void) {
    int n;

    if (scanf("%d", &n) != 1 || n <= 0) {
        return 0;
    }

    int *numeros = (int *)malloc((size_t)n * sizeof(int));
    if (numeros == NULL) {
        return 0;
    }

    for (int i = 0; i < n; i++) {
        if (scanf("%d", &numeros[i]) != 1) {
           
            free(numeros);
            return 0;
        }
    }

    qsort(numeros, (size_t)n, sizeof(int), comparar);

    int i = 0;
    while (i < n) {
        int valor = numeros[i];
        int contagem = 0;

        while (i < n && numeros[i] == valor) {
            contagem++;
            i++;
        }

        printf("%d aparece %d vez(es)\n", valor, contagem);
    }

    free(numeros);
    return 0;
}
